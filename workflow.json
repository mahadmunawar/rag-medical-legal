    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a medical information assistant.\n\nContext:\n{{ $json.context_text }}\n\nQuestion: {{ $json.clean_query }}\n\nStrict Rules:\n1. Use bullet points for readability.\n2. Do NOT diagnose or prescribe.\n3. If the Context is empty, answer from general knowledge but stay extremely cautious and do NOT cite any sources.\n4. Crucial: You MUST end your response with exactly: \"This is not medical advice.\"\n5. Cite source filenames if context is present (e.g. [Source: filename.csv]), otherwise do not cite.",
        "options": {}
      },
      "id": "4dbccd5f-2d2d-4764-b236-1ebd73c6b5f8",
