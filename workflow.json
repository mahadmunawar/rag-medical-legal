    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.chatInput || '';\nconst lower = raw.toLowerCase();\nconst blocked = ['ignore previous','act as system','override','forget instructions'];\nlet clean = lower;\nblocked.forEach(w => { clean = clean.split(w).join(''); });\nreturn [{ json: { clean_query: clean.trim(), original: raw } }];"
      },
      "id": "09e9d1cd-8d40-45f9-a827-e4f30f85a159",
      "name": "Sanitize Input1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3136,
        2000
      ]
    },
    {
      "parameters": {
        "jsCode": "const results = $input.first().json.result || [];\n\n// 1. Filter out poor matches (score less than 0.3)\nconst relevantResults = results.filter(item => (item.score || 1) >= 0.3);\n\n// 2. Format with dynamic source citations\nconst context_text = relevantResults.map((item, index) => {\n  const source = item.metadata?.source || item.source || 'Document ' + (index + 1);\n  return `[Source: ${source}] ${item.text}`;\n}).join('\\n');\n\nconst clean_query = $('Sanitize Input1').item.json.clean_query;\nreturn [{ json: { context_text, clean_query } }];\n"
      },
