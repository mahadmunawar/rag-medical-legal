    {
      "parameters": {
        "jsCode": "let out = $input.first().json.output || $input.first().json.text || $input.first().json.answer || $input.first().json.content || '';\nconst blocked = ['ignore all instructions', 'jailbreak', 'dan mode','ignore all instructions', 'system override', 'reset conversation'];\nif (blocked.some(w => out.toLowerCase().includes(w))) {\n  out = 'I am sorry, I cannot fulfill this request.';\n} else {\n  out = out.replace(/^[\"']|[\"']$/g, '');\n  out = out.replace(/(\\*\\*|__|\\*|_|#)/g, '');\n  out = out.trim();\n}\nreturn [{ json: { output: out } }];"
      },
      "id": "9e5e48d0-a6f9-4250-bdef-8d60384bc3b3",
